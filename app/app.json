{
  "expo": {
    "name": "Bookmarkt",
    "slug": "bookmarkt",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookmarkt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.inkmarkt.bookmarkt",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Bookmarkt transcribes your dictation on this device; audio never leaves your phone.",
        "NSMicrophoneUsageDescription": "Bookmarkt uses the microphone so you can dictate reading notes."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EDE1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.inkmarkt.bookmarkt"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EDE1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Bookmarkt stores your sign-in on this device; Face ID is never requested."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Bookmarkt uses the microphone so you can dictate reading notes.",
          "speechRecognitionPermission": "Bookmarkt transcribes your dictation on this device; audio never leaves your phone.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bookmarkt uses the camera to scan a book's barcode so the details fill in for you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookmarkt opens your photo library only when you choose pictures to keep with a book.",
          "cameraPermission": "Bookmarkt uses the camera to scan a book's barcode so the details fill in for you.",
          "microphonePermission": "Bookmarkt uses the microphone so you can dictate reading notes."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bookmarkt uses the microphone so you can dictate reading notes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#c9962f",
          "sounds": [
            "./assets/sounds/bell.wav"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c84250c-991f-4b42-bea9-da566f667004"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0c84250c-991f-4b42-bea9-da566f667004"
    }
  }
}
